# Everything the CI jobs need, so a run downloads nothing: Godot (checked
# against the release's SHA512), a virtual display and software GL for the
# render probes, Python and uv with the tool tests' packages, and Node for the
# workflow's JavaScript actions.
#
# The workflow tags this image with a hash of this file and builds it only
# when the registry does not have that tag yet; edit this file to rebuild.
FROM node:24-bookworm@sha256:e2007d1f4e652444f88d9bb196256d2d035269015e3d27a0d47c1d0cb5192a98

ARG GODOT_VERSION=4.7.2
ARG GODOT_SHA512=9aa00f7a605200940bce3027a567b782f49bd8e940dd06ae9e987bd65aee1b1467edd56ed84fcdcbdd44354bf613bdbb4e5d2913e925850368e150c59ed54c65
ARG UV_VERSION=0.10.10

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git unzip python3 \
        xvfb xauth \
        libgl1 libgl1-mesa-dri libglx-mesa0 libegl1 \
        libx11-6 libxcursor1 libxinerama1 libxrandr2 libxi6 libxext6 libxrender1 \
        libxkbcommon0 libxkbcommon-x11-0 libfontconfig1 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/godot.zip \
        "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_linux.x86_64.zip" \
    && echo "${GODOT_SHA512}  /tmp/godot.zip" | sha512sum -c - \
    && mkdir -p /opt/godot \
    && unzip -q /tmp/godot.zip -d /opt/godot \
    && mv "/opt/godot/Godot_v${GODOT_VERSION}-stable_linux.x86_64" /opt/godot/godot \
    && ln -s /opt/godot/godot /usr/local/bin/godot \
    && rm /tmp/godot.zip \
    && godot --headless --version

RUN curl -fsSL -o /tmp/uv.tar.gz \
        "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
    && tar -xzf /tmp/uv.tar.gz -C /usr/local/bin --strip-components=1 \
    && rm /tmp/uv.tar.gz \
    && uv --version

# The tool tests' Python and packages, fetched once into the image. The
# pinned numpy needs Python 3.12 or later, and bookworm's own is 3.11, so
# uv brings its own 3.12.
ENV UV_CACHE_DIR=/opt/uv-cache \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PYTHON=3.12 \
    KIT_TEST_ENGINE=/opt/godot/godot
RUN uv python install 3.12 \
    && chmod -R a+rX /opt/uv-python
ENV UV_PYTHON_DOWNLOADS=never
RUN uv run --no-project --with Pillow==11.3.0 --with numpy==2.5.5 --with pytest python -I -c "import PIL, numpy, pytest" \
    && chmod -R a+rwX /opt/uv-cache
